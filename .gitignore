# Expert pack content is user/community-built. The repo ships only the
# directory shell so Forge has somewhere to write. Real packs are deployed
# to the broker via admin/hub.py and discovered via /search.
expert-packs/*
!expert-packs/.gitkeep

# Per-session working drafts at the repo root (knowledge reports, scratch).
# Pack files with similar names are still tracked normally inside packs.
/occ-*.md
